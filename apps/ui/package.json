{
  "name": "@geniro/ui",
  "version": "0.1.0",
  "private": true,
  "description": "geniro UI — Electron app that supervises the local daemon and hosts the React renderer",
  "productName": "Geniro",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:mac": "node ../../scripts/build-mac.mjs",
    "generate:api": "./scripts/generate-api.sh && pnpm run lint:fix",
    "preview": "electron-vite preview",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1",
    "build-storybook": "storybook build",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src .storybook",
    "lint:fix": "eslint src .storybook --fix",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@geniro/daemon": "workspace:*",
    "@uiw/react-md-editor": "^4.1.1",
    "recharts": "^3.10.1",
    "socket.io-client": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.40.1",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-slot": "^1.3.0",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@tailwindcss/vite": "^4.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@xyflow/react": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^42.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "elkjs": "^0.11.1",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "refractor": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "storybook": "^10.5.10",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.9"
  }
}
