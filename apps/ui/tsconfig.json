{
  "extends": "../../tsconfig.json",
  "include": [
    "src/**/*",
    "scripts/**/*.ts",
    "electron.vite.config.ts",
    ".storybook/**/*"
  ],
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@packages/*": ["../../packages/*/src"]
    }
  }
}
