{
  "$schema": "https://turborepo.org/schema.json",
  "extends": ["//"],
  // No `^build`: the UI imports no workspace package (eslint's
  // no-restricted-imports holds that). `build` keeps it for packaging.
  // The daemon files below are read from disk by UI specs, so they are
  // inputs of every UI test task.
  "tasks": {
    "check-types": { "dependsOn": [] },
    "test": {
      "dependsOn": [],
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/apps/daemon/src/utils/handshake.ts",
        "$TURBO_ROOT$/apps/daemon/src/utils/stop-cause.ts",
        "$TURBO_ROOT$/apps/daemon/src/v1/agents/chat.types.ts",
        "$TURBO_ROOT$/apps/daemon/src/v1/agents/utils/artifact-page.ts",
        "$TURBO_ROOT$/apps/daemon/src/v1/agents/utils/artifact-runtime.ts",
        "$TURBO_ROOT$/apps/daemon/src/v1/migrations/migrations.types.ts",
        "$TURBO_ROOT$/apps/daemon/src/v1/teams/utils/prompt-cache-standing.ts"
      ]
    },
    "test:unit": {
      "dependsOn": [],
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/apps/daemon/src/utils/handshake.ts",
        "$TURBO_ROOT$/apps/daemon/src/utils/stop-cause.ts",
        "$TURBO_ROOT$/apps/daemon/src/v1/agents/chat.types.ts",
        "$TURBO_ROOT$/apps/daemon/src/v1/agents/utils/artifact-page.ts",
        "$TURBO_ROOT$/apps/daemon/src/v1/agents/utils/artifact-runtime.ts",
        "$TURBO_ROOT$/apps/daemon/src/v1/migrations/migrations.types.ts",
        "$TURBO_ROOT$/apps/daemon/src/v1/teams/utils/prompt-cache-standing.ts"
      ]
    },
    "test:cov": {
      "dependsOn": [],
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/apps/daemon/src/utils/handshake.ts",
        "$TURBO_ROOT$/apps/daemon/src/utils/stop-cause.ts",
        "$TURBO_ROOT$/apps/daemon/src/v1/agents/chat.types.ts",
        "$TURBO_ROOT$/apps/daemon/src/v1/agents/utils/artifact-page.ts",
        "$TURBO_ROOT$/apps/daemon/src/v1/agents/utils/artifact-runtime.ts",
        "$TURBO_ROOT$/apps/daemon/src/v1/migrations/migrations.types.ts",
        "$TURBO_ROOT$/apps/daemon/src/v1/teams/utils/prompt-cache-standing.ts"
      ]
    },
    "build:tests": { "dependsOn": [] },
    "test:integration": { "dependsOn": [] }
  }
}
