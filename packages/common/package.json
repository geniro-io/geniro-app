{
  "name": "@packages/common",
  "version": "1.2.8",
  "author": "Sergey Razumovskiy <s.razumru@gmail.com>",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@nestjs/common": "^12.1.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.2",
    "lodash": "^4.18.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.1.2",
    "@types/lodash": "^4.17.25",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "main": "dist/index.js",
  "peerDependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0"
  },
  "scripts": {
    "lint:fix": "pnpm run lint --fix",
    "lint": "pnpm eslint src",
    "build": "swc src -d dist --config-file ../../.swcrc --strip-leading-paths --ignore '**/*.spec.ts'",
    "prebuild": "rm -rf ./dist || true",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run --fileParallelism",
    "test:cov": "vitest run --coverage --passWithNoTests"
  },
  "types": "src/index.ts"
}
