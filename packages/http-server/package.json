{
  "name": "@packages/http-server",
  "version": "1.8.8",
  "author": "Sergey Razumovskiy <s.razumru@gmail.com>",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@fastify/compress": "^9.2.0",
    "@fastify/multipart": "^10.1.2",
    "@fastify/static": "^10.1.5",
    "@nestjs/common": "^12.1.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-fastify": "^12.1.2",
    "@nestjs/swagger": "^12.0.2",
    "@packages/common": "workspace:*",
    "@packages/metrics": "workspace:*",
    "@scalar/nestjs-api-reference": "^1.2.26",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cls-rtracer": "^2.6.4",
    "fastify": "^5.12.5",
    "fastify-qs": "^5.0.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "lodash": "^4.18.1",
    "nestjs-zod": "~5.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "~4.4.3"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.1.2",
    "@types/lodash": "^4.17.25",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "type-fest": "^5.10.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "main": "dist/index.js",
  "peerDependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/swagger": "^12.0.0",
    "@packages/common": "workspace:*",
    "@packages/metrics": "workspace:*"
  },
  "scripts": {
    "lint:fix": "pnpm run lint --fix",
    "lint": "pnpm eslint src",
    "build": "swc src -d dist --config-file ../../.swcrc --strip-leading-paths --ignore '**/*.spec.ts'",
    "prebuild": "rm -rf ./dist || true",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run --fileParallelism",
    "test:cov": "vitest run --coverage --passWithNoTests"
  },
  "types": "src/index.ts"
}
